# Copy to .env and fill in. Never commit .env.
# Leave LLM_PROVIDER unset to prefer configured Groq, then Gemini, then Hugging Face APIs.
# Supported explicit values: gemini, groq, huggingface, local.
# LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google AI Studio (Gemini) through its OpenAI-compatible endpoint. Key from aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Thinking depth for Gemini 3 models: low, medium or high.
GEMINI_REASONING_EFFORT=medium

# Free alternative: Hugging Face Inference Providers (token from hf.co/settings/tokens)
# Set LLM_PROVIDER=huggingface to use this instead of Groq.
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b

# Local Qwen is optional. Select LLM_PROVIDER=local to load this checkpoint.
# LLM_MODEL=Qwen/Qwen3-1.7B

# Cache LLM replies on disk for this many hours so notebook re-runs repeat exactly (0 disables).
LLM_CACHE_HOURS=24

# Data and research settings
PRICE_PERIOD=1y
NEWS_LOOKBACK_DAYS=30
MAX_NEWS_ARTICLES=12
NEAR_DUPLICATE_THRESHOLD=0.45
SEC_USER_AGENT=InvestmentResearchAgent your-email@example.com
