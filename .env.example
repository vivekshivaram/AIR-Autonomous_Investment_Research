# Copy to .env to override defaults. Nothing here is secret; no API keys are required.

# Local LLM: a Hugging Face model id, loaded with Transformers (about 4 GB download).
# With a GPU that has 8 GB or more, Qwen/Qwen3-4B-Instruct-2507 gives better news judgments.
LLM_MODEL=Qwen/Qwen3-1.7B

# Required by SEC EDGAR: identify yourself with a contact email
SEC_USER_AGENT=InvestmentResearchAgent your-email@example.com

# Research settings
DEFAULT_SYMBOL=MSFT
DEFAULT_BENCHMARK=SPY
PRICE_PERIOD=1y
NEWS_LOOKBACK_DAYS=30
MAX_NEWS_ARTICLES=12
